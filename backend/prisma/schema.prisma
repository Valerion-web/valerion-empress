generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum PayrollStatus {
  PENDING
  PAID
}

enum RecruitmentStatus {
  OPEN
  CLOSED
  FILLED
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PerformanceStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum AnnouncementAudience {
  ALL
  EMPLOYEES
  MANAGERS
  HR
  SUPER_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum AssetAllocationStatus {
  ALLOCATED
  RETURNED
}

enum AssetHistoryAction {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  STATUS_CHANGED
  DELETED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  isVerified    Boolean    @default(false)
  status        UserStatus @default(PENDING)
  roleId        String
  departmentId  String?
  designationId String?
  managerId     String?
  branchId      String?
  refreshToken  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  role        Role         @relation(fields: [roleId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  manager     User?        @relation("UserManager", fields: [managerId], references: [id])
  branch      Branch?      @relation("UserBranch", fields: [branchId], references: [id])

  employeeProfile      EmployeeProfile?
  teamMembers          User[]               @relation("UserManager")
  attendances          Attendance[]
  leaves               Leave[]
  leaveBalances        LeaveBalance[]
  payrolls             Payroll[]
  salaries             Salary[]
  performances         Performance[]        @relation("PerformanceEmployee")
  reviewedPerformances Performance[]        @relation("PerformanceReviewer")
  goals                Goal[]
  reviewRequests       Review[]             @relation("ReviewUser")
  reviewActions        Review[]             @relation("ReviewReviewer")
  recruitment          Recruitment[]
  jobApplications      Candidate[]          @relation("CandidateUser")
  interviews           Interview[]          @relation("InterviewInterviewer")
  tickets              HelpdeskTicket[]     @relation("TicketUser")
  assignedTickets      HelpdeskTicket[]     @relation("TicketAssignee")
  notifications        Notification[]
  auditLogs            AuditLog[]
  approvals            Approval[]           @relation("ApprovalRequestedBy")
  approveAction        Approval[]           @relation("ApprovalApprover")
  workflows            Workflow[]
  trainings            Training[]
  certificates         Certificate[]
  assetAllocations     AssetAllocation[]
  assetHistory         AssetHistory[]
  documents            Document[]
  calendarEvents       CalendarEvent[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  createdBranches      Branch[]             @relation("UserCreatedBranches")
  createdAnnouncements Announcement[]       @relation("AnnouncementCreatedBy")
  approvedLeaves       Leave[]              @relation("LeaveApprover")
  trainingAssignments  TrainingAssignment[]

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  users        User[]
  employees    Employee[]
  jobs         Job[]
  trainings    Training[]
  events       CalendarEvent[]
  recruitments Recruitment[]   @relation("RecruitmentDepartment")
}

model Designation {
  id          String   @id @default(uuid())
  name        String   @unique
  level       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  employees Employee[]
}

model Employee {
  id               String         @id @default(uuid())
  employeeId       String         @unique
  firstName        String
  lastName         String
  email            String         @unique
  phone            String?
  gender           Gender?
  dateOfBirth      DateTime?
  departmentId     String
  designationId    String
  joiningDate      DateTime
  employmentType   EmploymentType @default(FULL_TIME)
  salary           Decimal?       @db.Decimal(12, 2)
  profileImage     String?
  address          String?
  emergencyContact String?
  bloodGroup       String?
  status           EmployeeStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  department  Department  @relation(fields: [departmentId], references: [id])
  designation Designation @relation(fields: [designationId], references: [id])

  @@index([email])
  @@index([employeeId])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
}

model EmployeeProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  employeeCode      String    @unique
  gender            Gender?
  dateOfBirth       DateTime?
  dateOfJoining     DateTime?
  workLocation      String?
  emergencyContact  String?
  address           String?
  city              String?
  postalCode        String?
  country           String?
  maritalStatus     String?
  nationality       String?
  bankAccountNumber String?
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  location  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Leave {
  id           String      @id @default(uuid())
  userId       String
  leaveType    LeaveType
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  reason       String
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  remarks      String?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([userId, status])
}

model LeaveBalance {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  annual    Int      @default(12)
  used      Int      @default(0)
  remaining Int      @default(12)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model Payroll {
  id            String        @id @default(uuid())
  userId        String
  basicSalary   Float
  allowances    Float         @default(0)
  deductions    Float         @default(0)
  bonus         Float         @default(0)
  netSalary     Float
  month         Int
  year          Int
  paymentStatus PayrollStatus @default(PENDING)
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model Salary {
  id            String    @id @default(uuid())
  userId        String
  basic         Float
  hra           Float     @default(0)
  allowance     Float     @default(0)
  bonus         Float     @default(0)
  deductions    Float     @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Performance {
  id           String            @id @default(uuid())
  employeeId   String
  reviewerId   String
  reviewPeriod String
  reviewDate   DateTime
  rating       Int
  goals        String
  achievements String
  strengths    String
  improvements String
  comments     String
  status       PerformanceStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  employee User @relation("PerformanceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer User @relation("PerformanceReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("ACTIVE")
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  reviewerId String
  period     String
  feedback   String?
  rating     Int?
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User @relation("ReviewUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
}

model Recruitment {
  id            String            @id @default(uuid())
  title         String
  departmentId  String?
  managerId     String?
  status        RecruitmentStatus @default(OPEN)
  openPositions Int
  budget        Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  manager    User?       @relation(fields: [managerId], references: [id])
  department Department? @relation("RecruitmentDepartment", fields: [departmentId], references: [id])
  jobs       Job[]
}

model Job {
  id            String   @id @default(uuid())
  title         String
  departmentId  String?
  recruitmentId String?
  type          String
  location      String?
  description   String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department  Department?  @relation(fields: [departmentId], references: [id])
  recruitment Recruitment? @relation(fields: [recruitmentId], references: [id])
  candidates  Candidate[]
}

model Candidate {
  id        String          @id @default(uuid())
  userId    String?
  jobId     String
  firstName String
  lastName  String
  email     String
  phone     String?
  resumeUrl String?
  source    String?
  status    CandidateStatus @default(APPLIED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User?         @relation("CandidateUser", fields: [userId], references: [id])
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews   Interview[]
  offerLetters OfferLetter[]
}

model Interview {
  id            String    @id @default(uuid())
  candidateId   String
  interviewerId String?
  scheduledAt   DateTime?
  mode          String?
  round         Int?      @default(1)
  status        String    @default("SCHEDULED")
  feedback      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer User?     @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
}

model OfferLetter {
  id            String    @id @default(uuid())
  candidateId   String
  jobId         String?
  offeredSalary Float?
  status        String    @default("DRAFT")
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Training {
  id           String    @id @default(uuid())
  title        String
  description  String?
  departmentId String?
  trainer      String?
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("PLANNED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department          Department?          @relation(fields: [departmentId], references: [id])
  courses             Course[]
  users               User[]
  trainingAssignments TrainingAssignment[]
}

model TrainingAssignment {
  id               String   @id @default(uuid())
  trainingId       String
  userId           String
  completionStatus String   @default("PENDING")
  assignedAt       DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
  @@index([userId])
}

model Course {
  id                  String   @id @default(uuid())
  trainingId          String?
  title               String
  description         String?
  duration            String?
  certificateRequired Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  training     Training?     @relation(fields: [trainingId], references: [id])
  certificates Certificate[]
}

model Certificate {
  id        String    @id @default(uuid())
  userId    String
  courseId  String?
  fileUrl   String?
  issuedAt  DateTime?
  expiryAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])
}

model Asset {
  id            String      @id @default(uuid())
  name          String
  type          String
  serialNumber  String?     @unique
  assetTag      String?     @unique
  categoryId    String?
  status        AssetStatus @default(AVAILABLE)
  description   String?
  purchasePrice Float?
  purchaseDate  DateTime?
  warrantyUntil DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category    AssetCategory?    @relation(fields: [categoryId], references: [id])
  allocations AssetAllocation[]
  history     AssetHistory[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model AssetAllocation {
  id          String                @id @default(uuid())
  assetId     String
  userId      String
  allocatedAt DateTime              @default(now())
  returnedAt  DateTime?
  status      AssetAllocationStatus @default(ALLOCATED)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId, status])
  @@index([userId, status])
}

model AssetCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]
}

model AssetHistory {
  id         String             @id @default(uuid())
  assetId    String
  action     AssetHistoryAction
  fromStatus AssetStatus?
  toStatus   AssetStatus?
  userId     String?
  notes      String?
  createdAt  DateTime           @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([userId, createdAt])
}

model Document {
  id         String   @id @default(uuid())
  userId     String
  title      String
  category   String
  storageUrl String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String    @default("INFO")
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
}

model HelpdeskTicket {
  id           String         @id @default(uuid())
  userId       String
  subject      String
  description  String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  category     String?
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User  @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  entity      String
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  approvals Approval[]
}

model Approval {
  id            String         @id @default(uuid())
  workflowId    String
  requestedById String
  approverId    String?
  status        ApprovalStatus @default(PENDING)
  comments      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  approver    User?    @relation("ApprovalApprover", fields: [approverId], references: [id])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  address   String?
  phone     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]          @relation("UserBranch")
  calendarEvents CalendarEvent[] @relation("CalendarEventBranch")
  createdByUser  User?           @relation("UserCreatedBranches", fields: [createdBy], references: [id])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  type      String   @default("PUBLIC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id          String   @id @default(uuid())
  name        String
  startTime   String
  endTime     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalendarEvent {
  id           String   @id @default(uuid())
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  createdById  String
  branchId     String?
  departmentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  branch     Branch?     @relation("CalendarEventBranch", fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
