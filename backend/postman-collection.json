  },
  "item": [
    {
      "name": "Auth / Login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@valerion.local\",\n  \"password\": \"Admin@123\"\n}"
        },
        "url": {"raw": "http://localhost:4000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "4000", "path": ["api", "auth", "login"]}
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer <access-token>"}],
        "url": {"raw": "http://localhost:4000/api/dashboard", "protocol": "http", "host": ["localhost"], "port": "4000", "path": ["api", "dashboard"]}
      }
    }
  ]
